<!--
  Add this <prototype> block to Ghidra/Processors/x86/data/languages/x86-16.cspec
  (inside <compiler_spec>, after the existing 16-bit prototypes).

  Notes:
  - extrapop="unknown" lets the decompiler compute callee cleanup (Pascal style).
  - stackshift="4" accounts for the far return address (CS:IP).
  - type="pascal" is a hint; full left-to-right ordering may still need frontend support
    (see Ghidra issues #496 and #2315). For many cases the stack layout + manual
    signature overrides or a post-processing script is sufficient.
-->
<prototype name="__pascal16far" extrapop="unknown" stackshift="4" type="pascal">
  <input>
    <pentry minsize="1" maxsize="500" align="2">
      <addr offset="4" space="stack"/>
    </pentry>
  </input>
  <output>
    <pentry minsize="1" maxsize="2">
      <register name="AX"/>
    </pentry>
    <pentry minsize="3" maxsize="4">
      <addr space="join" piece1="DX" piece2="AX"/>
    </pentry>
  </output>
  <unaffected>
    <register name="SP"/>
    <register name="BP"/>
    <register name="SI"/>
    <register name="DI"/>
    <register name="DS"/>
    <register name="CS"/>
    <register name="ES"/>
    <register name="SS"/>
    <register name="DF"/>
  </unaffected>
</prototype>

<!-- Optional near variant -->
<prototype name="__pascal16near" extrapop="unknown" stackshift="2" type="pascal">
  <input>
    <pentry minsize="1" maxsize="500" align="2">
      <addr offset="2" space="stack"/>
    </pentry>
  </input>
  <output>
    <pentry minsize="1" maxsize="2">
      <register name="AX"/>
    </pentry>
    <pentry minsize="3" maxsize="4">
      <addr space="join" piece1="DX" piece2="AX"/>
    </pentry>
  </output>
  <unaffected>
    <register name="SP"/>
    <register name="BP"/>
    <register name="SI"/>
    <register name="DI"/>
    <register name="DS"/>
    <register name="CS"/>
    <register name="ES"/>
    <register name="SS"/>
    <register name="DF"/>
  </unaffected>
</prototype>
